<section class="services section-wrap" id="tratamientos">
  <div class="section-heading"><p class="eyebrow">{{ section.settings.kicker }}</p><h2>{{ section.settings.heading }}</h2><p>{{ section.settings.intro }}</p></div>
  <div class="service-grid">
    {% for block in section.blocks %}
      <article class="service-card" {{ block.shopify_attributes }}>
        <span class="service-icon">{{ block.settings.symbol }}</span><h3>{{ block.settings.title }}</h3><p>{{ block.settings.description }}</p>
        <a class="button button-small" href="https://wa.me/{{ settings.whatsapp_number | remove: ' ' | remove: '+' | remove: '-' }}?text={{ block.settings.whatsapp_message | url_encode }}" target="_blank" rel="noopener">{{ block.settings.button_label }}</a>
      </article>
    {% endfor %}
  </div>
</section>
{% schema %}
{"name":"Tratamientos","settings":[{"type":"text","id":"kicker","label":"Texto pequeño","default":"CUIDADO Y BIENESTAR"},{"type":"text","id":"heading","label":"Título","default":"Conocé todos los servicios que tenemos para ofrecerte"},{"type":"text","id":"intro","label":"Descripción","default":"Un espacio pensado para dedicarte tiempo y cuidar de vos."}],"blocks":[{"type":"service","name":"Tratamiento","settings":[{"type":"text","id":"symbol","label":"Ícono o símbolo","default":"✧"},{"type":"text","id":"title","label":"Nombre","default":"Tratamientos corporales"},{"type":"textarea","id":"description","label":"Descripción","default":"Reducción, tonificación y modelado."},{"type":"text","id":"button_label","label":"Botón","default":"Consultar turno"},{"type":"text","id":"whatsapp_message","label":"Mensaje WhatsApp","default":"Hola, quisiera consultar por este tratamiento."}]}],"presets":[{"name":"Tratamientos","blocks":[{"type":"service","settings":{"symbol":"♧","title":"Tratamientos corporales","description":"Reducción, tonificación y modelado."}},{"type":"service","settings":{"symbol":"✧","title":"Tratamientos faciales","description":"Limpieza, hidratación y rejuvenecimiento."}},{"type":"service","settings":{"symbol":"◉","title":"Masoterapia","description":"Relajación, descontracturante y bienestar."}},{"type":"service","settings":{"symbol":"⌁","title":"Cejas","description":"Diseño y depilación con hilo."}}]}]}
{% endschema %}